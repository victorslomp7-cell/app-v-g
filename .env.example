# Copie este arquivo para ".env" apenas se for rodar em modo standalone (self-hosted).
# Na Vercel, essas variáveis são configuradas no painel do projeto (Settings > Environment Variables).

# Turso (banco de dados na nuvem). Deixe em branco para usar um arquivo SQLite local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (armazenamento de fotos/documentos na nuvem). Deixe em branco para salvar localmente em server/uploads.
BLOB_READ_WRITE_TOKEN=

# Senha compartilhada do casal para acessar o app. Deixe em branco para não pedir senha (uso local/Tailscale).
APP_PASSWORD=
